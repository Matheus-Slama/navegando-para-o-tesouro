{
  "name": "navegando-para-o-tesouro",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "description": "Jogo educativo web para ensino do problema do caminho mínimo em grafos.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "test": "node scripts/verify-all.mjs",
    "test:maps": "node scripts/verify-maps.mjs",
    "test:highscore": "node scripts/verify-highscore.mjs",
    "test:devices": "node scripts/verify-device-config.mjs",
    "test:dijkstra": "node scripts/verify-dijkstra-walkthrough.mjs && node scripts/verify-dijkstra-selection.mjs",
    "test:browser:hint": "node scripts/verify-game-hint.mjs",
    "test:browser:pause": "node scripts/verify-game-pause.mjs",
    "check": "pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "graphology": "^0.26.0",
    "graphology-generators": "^0.11.2",
    "lucide-react": "0.468.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1"
  },
  "packageManager": "pnpm@9.12.3"
}
